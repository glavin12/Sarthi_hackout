# Frontend → backend URLs (browser-side; must be host-reachable).
# Copy to .env.local for local `npm run dev`. Defaults are these values.
NEXT_PUBLIC_DATA_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_DECISION_ENGINE_URL=http://localhost:8001
NEXT_PUBLIC_NLP_URL=http://localhost:8002
# Demo hero customer id (stable_salaried → flips to stressed on missed_emi)
NEXT_PUBLIC_DEMO_CUSTOMER_ID=1
